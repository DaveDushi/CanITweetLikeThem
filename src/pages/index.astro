---
import Base from '../layouts/Base.astro';
import CreatorCard from '../components/CreatorCard.astro';
import { creators, categories, sortCreators } from '../lib/creators';
import { getScores, getUserVotes, getGenerationCounts, getDb } from '../lib/db';

const url = new URL(Astro.url);
const sort = ['top', 'new', 'az'].includes(url.searchParams.get('sort') ?? '')
  ? (url.searchParams.get('sort') as string)
  : 'top';
const category = url.searchParams.get('category');
const q = (url.searchParams.get('q') ?? '').trim().toLowerCase();

let scores = new Map<string, number>();
let genCounts = new Map<string, number>();
const userVotes = new Map<string, number>();
try {
  const db = getDb();
  if (db) {
    scores = await getScores(db);
    genCounts = await getGenerationCounts(db);
    const voterId = Astro.cookies.get('ctlt_voter')?.value;
    if (voterId) {
      const uv = await getUserVotes(db, voterId);
      for (const [k, v] of uv) userVotes.set(k, v);
    }
  }
} catch {
  // no D1 yet — render zeros
}

let list = creators;
if (category && categories.includes(category)) {
  list = list.filter((c) => c.category === category);
}
if (q) {
  list = list.filter(
    (c) =>
      c.name.toLowerCase().includes(q) ||
      c.handle.toLowerCase().includes(q) ||
      c.tagline.toLowerCase().includes(q),
  );
}
list = sortCreators(list, scores, sort);

function chipHref(cat?: string) {
  const p = new URLSearchParams();
  if (sort !== 'top') p.set('sort', sort);
  if (cat) p.set('category', cat);
  if (q) p.set('q', q);
  const s = p.toString();
  return s ? `/?${s}` : '/';
}

function sortHref(s: string) {
  const p = new URLSearchParams();
  if (s !== 'top') p.set('sort', s);
  if (category) p.set('category', category);
  if (q) p.set('q', q);
  const str = p.toString();
  return str ? `/?${str}` : '/';
}
---

<Base>
  <section class="hero wrap">
    <p class="hero-kicker">// {creators.length} creators · one question each</p>
    <h1>Can you tweet<br />like <span class="hl">them?</span></h1>
    <p class="sub">
      Every entry is a downloadable skill file that makes your AI write posts exactly
      like that creator. Grab one, feed it to your agent, and judge for yourself.
      Vote for the clones worth keeping.
    </p>
    <div class="hero-stats">
      <span><b>{creators.length}</b> skills</span>
      <span><b>$0</b> forever</span>
      <span><b>no</b> sign-up</span>
    </div>
  </section>

  <section class="controls wrap">
    <div class="controls-row">
      <div class="chips">
        <a href={chipHref()} class={`chip${!category ? ' on' : ''}`}>all</a>
        {categories.map((cat) => (
          <a href={chipHref(cat)} class={`chip${category === cat ? ' on' : ''}`}>{cat}</a>
        ))}
      </div>
      <div class="controls-right">
        <form method="get" action="/" style="display:flex;gap:8px;">
          {sort !== 'top' && <input type="hidden" name="sort" value={sort} />}
          {category && <input type="hidden" name="category" value={category} />}
          <input class="search-input" type="search" name="q" placeholder="search creators…" value={url.searchParams.get('q') ?? ''} />
        </form>
        <div class="chips">
          {[['top', '▲ top'], ['new', '✦ new'], ['az', 'A–Z']].map(([key, label]) => (
            <a href={sortHref(key)} class={`chip${sort === key ? ' on' : ''}`}>{label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="wrap grid">
    {list.map((creator, i) => (
      <CreatorCard
        creator={creator}
        score={scores.get(creator.slug) ?? 0}
        userVote={userVotes.get(creator.slug) ?? 0}
        genCount={genCounts.get(creator.slug) ?? 0}
        rank={i + 1}
      />
    ))}
    {list.length === 0 && <p class="empty-note">no clones match that search (yet)</p>}
  </section>
</Base>
