---
import Base from '../layouts/Base.astro';
---

<Base title="404 · Can I Tweet Like Them?">
  <div class="wrap" style="text-align:center;padding:110px 20px;">
    <p class="hero-kicker">// clone not found</p>
    <h1 style="font-family:var(--mono);font-size:clamp(30px,5vw,52px);">This voice doesn't exist (yet)</h1>
    <p class="sub" style="color:var(--muted);margin:18px auto 30px;">
      Either the URL is wrong, or nobody has cloned this creator yet. You could be the first.
    </p>
    <a href="/" class="btn btn-primary">← back to the leaderboard</a>
  </div>
</Base>
